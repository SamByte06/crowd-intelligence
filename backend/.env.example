# AI Crowd Intelligence System — Environment Configuration
# Copy to .env and customize for your deployment

# Application
APP_NAME=AI Crowd Intelligence System
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./crowd_intelligence.db
# DATABASE_URL=postgresql://user:password@localhost:5432/crowd_intelligence

# YOLO Detection
YOLO_MODEL_PATH=yolo11s.pt
YOLO_CONFIDENCE=0.25
YOLO_IOU_THRESHOLD=0.45
YOLO_IMAGE_SIZE=640
YOLO_DEVICE=auto

# Tracker
TRACKER_TYPE=botsort

# Camera Processing
CAMERA_FRAME_QUEUE_SIZE=4
CAMERA_RECONNECT_MAX_ATTEMPTS=10
CAMERA_RECONNECT_BASE_DELAY=2.0
CAMERA_RECONNECT_MAX_DELAY=60.0
CAMERA_HEALTH_CHECK_INTERVAL=30.0
CAMERA_FRAME_TIMEOUT=10.0

# Occupancy
DEFAULT_DENSITY_PER_SQM=2.0
MAX_OCCUPANCY_HARD_LIMIT=100000

# Flow Rates
FLOW_WINDOW_SECONDS=60
FLOW_SMOOTHING_FACTOR=0.3

# Forecasting
FORECAST_HORIZONS_MINUTES=5,10,15,30
FORECAST_MIN_DATA_POINTS=3

# Alerts
ALERT_COOLDOWN_SECONDS=300
ALERT_CONFIRMATION_SECONDS=30
DEFAULT_WARNING_THRESHOLD=0.75
DEFAULT_CRITICAL_THRESHOLD=0.90

# Security
SECRET_KEY=change-me-in-production-use-strong-random-key
API_KEY=

# WebSocket
WS_BROADCAST_INTERVAL=2.0
